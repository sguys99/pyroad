{
  "$comment": [
    "게시판 개인정보·외부 연락 유도 패턴 (P1-18). 정규식은 원문을 NFKC·소문자로 바꾼 뒤(전각 숫자·영문 → 반각) 검사합니다. flags 는 항상 'u' 가 붙습니다.",
    "category: personal_info(전화번호·주소·이메일·학교) | contact(게시판 밖 연락: 메신저 아이디, 오픈채팅, 링크, 만나자)",
    "오탐을 줄이려고 '숫자만 길게', '주소처럼 보이는 단어 하나'는 막지 않고, 번호·주소의 모양이나 '알려 줘' 같은 요청이 함께 있을 때만 막습니다.",
    "운영 중 보강: 새 우회 표현은 패턴을 추가하고 src/lib/moderation/__tests__/filter.test.ts 에 걸려야 하는 문장과 걸리면 안 되는 문장을 함께 넣습니다."
  ],
  "version": 1,
  "patterns": [
    {
      "id": "phone-mobile",
      "category": "personal_info",
      "note": "휴대폰 번호: 010-1234-5678, 010 1234 5678, 0 1 0 1 2 3 4 …, +82 10 …. 뒤 번호에 2~9가 하나도 없으면(0·1만 있는 이진수) 통과",
      "pattern": "(?<!\\d)(?:\\+?82[\\s.\\-)]*0?|0)[\\s.\\-_·]*1[\\s.\\-_·]*[016789](?=[\\s.\\-_·)(\\d]*[2-9])(?:[\\s.\\-_·)(]*\\d){7,8}(?![\\s.\\-]*\\d)"
    },
    {
      "id": "phone-landline",
      "category": "personal_info",
      "note": "지역 번호: 02-123-4567, 031 1234 5678",
      "pattern": "(?<!\\d)0(?:2|[3-6][1-5])[\\s.\\-)]*[2-9]\\d{2,3}[\\s.\\-]*\\d{4}(?!\\d)"
    },
    {
      "id": "phone-korean-digits",
      "category": "personal_info",
      "note": "한글로 쓴 휴대폰 번호: 공일공 일이삼사 …",
      "pattern": "(?:공|영)\\s*일\\s*(?:공|영|일|육|륙|칠|팔|구)(?:[\\s.\\-]*(?:공|영|일|이|삼|사|오|육|륙|칠|팔|구)){7,8}"
    },
    {
      "id": "phone-ask",
      "category": "personal_info",
      "note": "번호를 알려 달라거나 주겠다는 말 (전화번호부 프로그램 같은 말은 통과)",
      "pattern": "(?:(?:(?:전화|폰|핸드폰|휴대폰|휴대\\s*전화)\\s*번호|연락처)\\s*(?:좀\\s*)?(?:알려|가르쳐|줘|줄래|주라|남겨|보내|교환|공유)|번호\\s*(?:좀\\s*)?(?:교환|따)\\s*(?:하자|할래|해|줘))"
    },
    {
      "id": "email",
      "category": "personal_info",
      "note": "이메일: kid@naver.com, kid 골뱅이 naver 점 com, kid(at)gmail(dot)com",
      "pattern": "[a-z0-9._%+\\-]+\\s*(?:@|\\(at\\)|\\[at\\]|골뱅이)\\s*[a-z0-9\\-]+(?:\\s*(?:\\.|\\(dot\\)|\\[dot\\]|닷|점)\\s*[a-z0-9\\-]+)*\\s*(?:\\.|\\(dot\\)|\\[dot\\]|닷|점)\\s*(?:com|net|org|kr|co|io|me|edu)(?![a-z])"
    },
    {
      "id": "address-unit",
      "category": "personal_info",
      "note": "아파트 동·호수: 101동 1203호",
      "pattern": "\\d{1,4}\\s*동\\s*\\d{1,4}\\s*호"
    },
    {
      "id": "address-building",
      "category": "personal_info",
      "note": "아파트·빌라 이름 + 동: 햇살아파트 101동",
      "pattern": "(?:아파트|빌라|맨션|오피스텔)\\s*\\d{1,4}\\s*동"
    },
    {
      "id": "address-lot",
      "category": "personal_info",
      "note": "지번·도로명 번호: 123-4번지, 테헤란로 12번길",
      "pattern": "(?:\\d{1,5}(?:\\s*-\\s*\\d{1,5})?\\s*번지|[가-힣]{1,10}(?:로|길)\\s*\\d{1,4}\\s*번길)"
    },
    {
      "id": "address-region",
      "category": "personal_info",
      "note": "시·도 + 구·군·시 + 동·로: 서울 강남구 역삼동 (시·도 이름으로 시작할 때만)",
      "pattern": "(?:서울|부산|대구|인천|광주|대전|울산|세종|경기|강원|충북|충남|충청|전북|전남|전라|경북|경남|경상|제주)[가-힣]{0,5}\\s+[가-힣]{1,6}(?:시|구|군)\\s+[가-힣]{1,8}(?:동|읍|면|로|길)(?![가-힣])"
    },
    {
      "id": "address-ask",
      "category": "personal_info",
      "note": "사는 곳 묻기·알려 주기 (물고기는 어디 살아요? 같은 말은 통과)",
      "pattern": "(?:(?:집\\s*주소|사는\\s*곳|사는\\s*동네)\\s*(?:가|는|이|좀)?\\s*(?:알려|가르쳐|어디|뭐|공유|줘)|(?:너|넌|니|너는|님|님은|형|누나|언니|오빠)\\s*(?:집\\s*)?어디\\s*(?:살아|사니|사냐|살아요|사세요|사는지))"
    },
    {
      "id": "school-class",
      "category": "personal_info",
      "note": "학교 이름 + 학년·반: 한빛초등학교 3학년, 한빛초 3학년 2반 (학교 이름 없이 '3학년 2반'만은 통과)",
      "pattern": "[가-힣]{1,10}(?:초등학교|초교|중학교|고등학교|초)\\s*\\d{1,2}\\s*(?:학년|반)"
    },
    {
      "id": "school-attend",
      "category": "personal_info",
      "note": "다니는 학교 이름: 한빛초등학교 다녀요",
      "pattern": "[가-힣]{1,10}(?:초등학교|초교|중학교)\\s*(?:에\\s*)?(?:다녀|다니|다님)"
    },
    {
      "id": "class-number",
      "category": "personal_info",
      "note": "학년·반·번호: 3학년 2반 15번",
      "pattern": "\\d\\s*학년\\s*\\d{1,2}\\s*반\\s*\\d{1,2}\\s*번"
    },
    {
      "id": "contact-link",
      "category": "contact",
      "note": "링크 (게시판 밖으로 데려가는 주소)",
      "pattern": "(?:https?:\\/\\/|www\\.|open\\.kakao\\.com|discord\\.gg|t\\.me\\/|bit\\.ly|forms\\.gle)"
    },
    {
      "id": "contact-openchat",
      "category": "contact",
      "note": "오픈채팅방",
      "pattern": "(?:오픈\\s*(?:채팅|채팅방|톡|카톡|단톡)|오카방|오톡방|단톡방\\s*(?:들어|초대|만들))"
    },
    {
      "id": "contact-messenger",
      "category": "contact",
      "note": "메신저·SNS·게임 아이디 주고받기: 카톡 아이디, 인스타 맞팔, 로블록스 친추",
      "pattern": "(?:카톡|카카오톡|카카오|kakao|katalk|ktalk|인스타|instagram|insta|페북|페이스북|facebook|틱톡|tiktok|텔레그램|텔레|telegram|디스코드|디코|discord|라인|트위터|twitter|스냅챗|snapchat|제페토|zepeto|로블록스|roblox|마크|마인크래프트|minecraft)\\s*(?:아이디|아뒤|id|계정|친추|친구\\s*추가|맞팔|팔로우|dm|디엠|주소|닉네임|닉|방|서버|초대)"
    },
    {
      "id": "contact-id",
      "category": "contact",
      "note": "아이디 알려 주기: 내 아이디는 abcd123",
      "pattern": "(?:아이디|아뒤)\\s*(?:는|은|:|=)?\\s*[a-z0-9._\\-]{4,}"
    },
    {
      "id": "contact-dm",
      "category": "contact",
      "note": "개인 메시지로 부르기",
      "pattern": "(?:디엠|(?<![a-z])dm(?![a-z])|귓속말|갠톡|개인\\s*톡|따로\\s*연락)\\s*(?:해|줘|보내|주세요|ㄱ|하자|할래)"
    },
    {
      "id": "contact-meet",
      "category": "contact",
      "note": "실제로 만나자는 말",
      "pattern": "(?:(?:실제로|오프라인에서|오프에서)\\s*(?:한\\s*번\\s*)?(?:만나|보자|볼래|놀자)|(?:직접|따로)\\s*(?:한\\s*번\\s*)?만나(?:자|요|서|볼래|줄래))"
    },
    {
      "id": "contact-photo",
      "category": "contact",
      "note": "얼굴·몸 사진 요청 (결과 사진 같은 말은 통과)",
      "pattern": "(?:(?:얼굴|몸|본인|너|니|네)\\s*사진|셀카)\\s*(?:좀\\s*)?(?:보내|보여|올려|찍어)"
    }
  ]
}
