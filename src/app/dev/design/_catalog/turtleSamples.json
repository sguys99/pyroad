{"square":{"code":"import turtle\n\nt = turtle.Turtle()\nt.shape(\"turtle\")\nt.color(\"seagreen\", \"palegreen\")\nt.pensize(4)\n\n# 정사각형: 앞으로 150, 왼쪽으로 90도를 4번!\nfor i in range(4):\n    t.forward(150)\n    t.left(90)\n","stdout":"","commands":[["n",0,{"x":0,"y":0,"h":0,"d":1,"pc":"black","fc":"black","w":1,"sp":3,"v":1,"sh":"classic","sz":[1,1,1]}],["s",0,{"sh":"turtle"}],["s",0,{"pc":"seagreen","fc":"palegreen"}],["s",0,{"w":4}],["m",0,150,0],["r",0,90,90],["m",0,150,150],["r",0,90,180],["m",0,0,150],["r",0,90,270],["m",0,0,0],["r",0,90,360]]},"star":{"code":"from turtle import *\n\nshape(\"turtle\")\ncolor(\"darkorange\", \"gold\")\npensize(3)\nspeed(6)\n\npenup()\ngoto(-110, 40)\npendown()\n\nbegin_fill()\nfor i in range(5):\n    forward(220)\n    right(144)\nend_fill()\n","stdout":"","commands":[["n",0,{"x":0,"y":0,"h":0,"d":1,"pc":"black","fc":"black","w":1,"sp":3,"v":1,"sh":"classic","sz":[1,1,1]}],["s",0,{"sh":"turtle"}],["s",0,{"pc":"darkorange","fc":"gold"}],["s",0,{"w":3}],["s",0,{"sp":6}],["s",0,{"d":0}],["m",0,-110,40],["s",0,{"d":1}],["bf",0],["m",0,110,40],["r",0,-144,216],["m",0,-67.98,-89.31],["r",0,-144,72],["m",0,0,119.92],["r",0,-144,288],["m",0,67.98,-89.31],["r",0,-144,144],["m",0,-110,40],["r",0,-144,0],["ef",0]]},"flower":{"code":"import turtle\n\nt = turtle.Turtle()\nt.speed(9)\npetal_colors = [\"hotpink\", \"orchid\", \"lightcoral\", \"plum\"]\n\n# 꽃잎: 원 12개를 30도씩 돌려 가며\nfor i in range(12):\n    t.color(\"mediumvioletred\", petal_colors[i % 4])\n    t.begin_fill()\n    t.circle(70)\n    t.end_fill()\n    t.left(30)\n\n# 가운데 꽃술\nt.dot(40, \"gold\")\nt.dot(18, \"orange\")\n\n# 줄기와 잎\nt.penup()\nt.goto(0, -150)\nt.setheading(90)\nt.color(\"forestgreen\", \"yellowgreen\")\nt.pensize(5)\nt.pendown()\nt.forward(80)\nt.begin_fill()\nt.circle(-45, 90)\nt.right(90)\nt.circle(-45, 90)\nt.end_fill()\nt.hideturtle()\n","stdout":"","commands":[["n",0,{"x":0,"y":0,"h":0,"d":1,"pc":"black","fc":"black","w":1,"sp":3,"v":1,"sh":"classic","sz":[1,1,1]}],["s