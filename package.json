{
  "name": "pyroad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/pyodide/copy-assets.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/pyodide/copy-assets.mjs",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:pyodide": "vitest run --config vitest.pyodide.config.ts",
    "test:e2e": "playwright test",
    "optimize:svg": "svgo -f public/characters --recursive",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset --local",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/types/database.generated.ts && prettier --write src/lib/types/database.generated.ts",
    "test:rls": "bash supabase/tests/run.sh fast",
    "test:rls:ci": "bash supabase/tests/run.sh ci",
    "content:build": "tsx scripts/content/build.ts",
    "content:extract": "tsx scripts/content/extract-from-seed.ts",
    "content:compare": "tsx scripts/content/compare.ts",
    "pyodide:copy": "node scripts/pyodide/copy-assets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@base-ui/react": "^1.3.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.40.0",
    "@google/genai": "^1.47.0",
    "@sentry/nextjs": "^11.10.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "framer-motion": "^12.38.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.7.0",
    "next": "^15.5.0",
    "openai": "^6.33.0",
    "pyodide": "314.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.1.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.0",
    "prettier": "^3.8.1",
    "svgo": "^4.0.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2",
    "yaml": "^2.9.1"
  }
}
