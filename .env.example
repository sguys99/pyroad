# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 사용자 API 키 암호화 (B13, 서버 전용). 32바이트를 base64로: openssl rand -base64 32
# 비워 두면 "내 API 키" 기능만 꺼지고(서버 무료 티어만) 앱은 그대로 동작.
# ⚠️ 운영 키를 잃어버리면 저장된 사용자 키를 복호화할 수 없음 (docs/release/v0.4-runbook.md)
API_KEY_ENCRYPTION_KEY=
# 키 교체 때만: 현재 키 버전(기본 1)과 이전 키 목록 "<버전>:<base64>[,<버전>:<base64>]"
# API_KEY_ENCRYPTION_KEY_VERSION=2
# API_KEY_ENCRYPTION_KEY_PREVIOUS=1:<이전 키 base64>

# 튜터 요청 한도 (P1-19, 서버 전용, 선택). 사용자마다 요청 유형별로 "분당/하루(KST 자정 기준)". 비우면 기본값
# 기본값과 근거: src/lib/tutor/rateLimit.ts. 카운터는 DB(api_rate_limits, 00016)라 Vercel 인스턴스가 여러 개여도 정확함
# TUTOR_LIMIT_INTRO=8/60           # 퀘스트 소개 (quest_intro, 캐시 적중도 셈)
# TUTOR_LIMIT_HINT=6/60            # 힌트 (hint_generator)
# TUTOR_LIMIT_FEEDBACK=12/200      # 실행 결과 피드백 (code_feedback)
# TUTOR_LIMIT_ENCOURAGEMENT=4/40   # 완료 격려 (encouragement)
# TUTOR_LIMIT_GUIDE=6/40           # 프로젝트 단계 안내 (project_guide)
# TUTOR_LIMIT_SUMMARY=3/20         # 스테이지 정리 (stage_summary, 캐시 적중도 셈)
# 본인 API 키 사용자 배수 "분/하루" (LLM 비용은 본인 부담이라 하루는 넉넉히, 분당은 서버 부하용)
# TUTOR_LIMIT_OWN_KEY_MULTIPLIER=2/5

# Admin (B37): 관리자는 auth.users.raw_app_meta_data 의 "role":"admin" 으로 판별 (docs/release/v0.4-runbook.md "관리자 role 설정").
# ADMIN_EMAIL 은 이행 기간 폴백(확인된 같은 이메일만 인정). v0.4 운영에서 role 설정을 확인한 뒤 다음 릴리즈에서 제거
ADMIN_EMAIL=sguys99@gmail.com

# Sentry 에러 모니터링 (P1-16, 선택). DSN이 없으면 Sentry는 완전히 꺼짐
# DSN: Sentry 프로젝트 > Settings > Client Keys (DSN). 브라우저 번들에 들어가는 공개 값
NEXT_PUBLIC_SENTRY_DSN=
# 소스맵 업로드용 (Vercel 빌드에서만 설정, 로컬은 비워 둠). 없으면 업로드를 건너뜀
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# 서버 트레이스 샘플링 (선택, 기본 꺼짐, 0.05 이하만 적용)
# SENTRY_TRACES_SAMPLE_RATE=0.01
