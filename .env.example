# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Admin
ADMIN_EMAIL=sguys99@gmail.com

# Sentry 에러 모니터링 (P1-16, 선택). DSN이 없으면 Sentry는 완전히 꺼짐
# DSN: Sentry 프로젝트 > Settings > Client Keys (DSN). 브라우저 번들에 들어가는 공개 값
NEXT_PUBLIC_SENTRY_DSN=
# 소스맵 업로드용 (Vercel 빌드에서만 설정, 로컬은 비워 둠). 없으면 업로드를 건너뜀
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# 서버 트레이스 샘플링 (선택, 기본 꺼짐, 0.05 이하만 적용)
# SENTRY_TRACES_SAMPLE_RATE=0.01
