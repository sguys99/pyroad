{
  "name": "pyroad-design-prototypes",
  "private": true,
  "type": "module",
  "description": "pyRoad Phase 2 디자인 시안 프로토타입 (앱 코드 아님). 진입점마다 Artifact로 공유할 단일 HTML을 만든다",
  "scripts": {
    "fonts": "node scripts/fetch-fonts.mjs",
    "content": "node scripts/gen-content.mjs",
    "build": "node build.mjs",
    "serve": "node serve.mjs",
    "shot": "node shot.mjs",
    "contrast": "node scripts/contrast.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.25.12",
    "pretendard": "1.3.9",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
